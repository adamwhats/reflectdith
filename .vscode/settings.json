{
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "rust-analyzer.rustfmt.overrideCommand": [
    "rustfmt",
    "+nightly",
    "--edition",
    "2024",
    "--config-path",
    "${workspaceFolder}/rustfmt.toml"
  ],
  "cSpell.words": [
    "boids"
  ]
}
