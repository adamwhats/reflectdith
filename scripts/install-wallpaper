#!/usr/bin/env bash
# Build and install the viewer, COSMIC applet, settings launcher, and mesh assets.
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
prefix=${1:-"$HOME/.local"}
if (( $# > 1 )); then
    echo "Usage: scripts/install-wallpaper [PREFIX]" >&2
    exit 2
fi
cargo build --locked --release --manifest-path "$repo_dir/Cargo.toml" -j "${CARGO_BUILD_JOBS:-4}"
cargo build --locked --release --manifest-path "$repo_dir/applet/Cargo.toml" -j "${CARGO_BUILD_JOBS:-4}"
# Replace binaries atomically, including when the installed applet is running.
install_binary() {
    local source=$1 destination=$2 temporary
    install -d "$(dirname -- "$destination")"
    temporary=$(mktemp "$destination.XXXXXX")
    if install -m755 "$source" "$temporary" && mv -f -- "$temporary" "$destination"; then
        return 0
    fi
    rm -f -- "$temporary"
    return 1
}
install_binary "$repo_dir/target/release/reflecdith" "$prefix/bin/reflecdith"
install_binary "$repo_dir/applet/target/release/reflecdith-applet" "$prefix/bin/reflecdith-applet"
install -d "$prefix/share/reflecdith/models" "$prefix/share/applications"
install -m644 "$repo_dir"/models/*.stl "$prefix/share/reflecdith/models/"
# Desktop launchers need an absolute path even when ~/.local/bin isn't on PATH.
python3 - "$repo_dir" "$prefix" <<'PY'
from pathlib import Path
import sys
repo, prefix = map(lambda p: Path(p).resolve(), sys.argv[1:])
executable = str(prefix / 'bin/reflecdith-applet')
# Desktop Entry Exec escaping (not shell quoting).
executable = executable.replace('\\', '\\\\').replace('"', '\\"').replace('`', '\\`').replace('$', '\\$').replace('%', '%%')
for source in (repo / 'applet/data').glob('*.desktop'):
    text = source.read_text().replace('Exec=reflecdith-applet', f'Exec="{executable}"')
    (prefix / 'share/applications' / source.name).write_text(text)
PY
printf 'Installed in %s. Close and reopen COSMIC Settings, then add ReflecDith in Panel settings, or run %s/bin/reflecdith-applet --settings\n' "$prefix" "$prefix"
